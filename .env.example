# Vaultwarden server (zelf-gehost) — niet-geheim
BW_SERVER_URL=https://secure.steno.nl

# Agent-identiteit (aparte login, alleen toegang tot de gedeelde collectie)
BW_CLIENTID=
BW_CLIENTSECRET=
BW_MASTERPASSWORD=

# Scope: alleen deze org/collectie wordt ooit doorzocht
VAULTWARDEN_ORG_ID=
VAULTWARDEN_COLLECTION_ID=

# Secret voor het MCP SSE-endpoint (?key=...), niet als pad-prefix — zie README
MCP_SSE_SECRET=

# --- Optioneel: inject_secret ---------------------------------------------
# Portainer-API (intern, op het hassio-netwerk) + een API-token (My account ->
# Access tokens). De tool wordt alleen geregistreerd als alle drie gezet zijn.
PORTAINER_URL=http://db21ed7f-portainer:9000
PORTAINER_API_KEY=
# Komma-gescheiden stack-ID's waar een geheim in een variabele mag worden gezet.
# Alleen standalone compose-stacks (geen git-stacks). Leeg = tool uit.
INJECT_ALLOWED_STACKS=

# --- Optioneel: login-tool -------------------------------------------------
# Standaard uit. Zet op true om de Playwright-login-tool te registreren.
ENABLE_LOGIN=false
